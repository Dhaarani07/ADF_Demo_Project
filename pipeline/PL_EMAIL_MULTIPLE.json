{
	"name": "PL_EMAIL_MULTIPLE",
	"properties": {
		"activities": [
			{
				"name": "send_email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logic_apps_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "logic_apps_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-90.eastus.logic.azure.com:443/workflows/321e2fc5663b40799e4bc831b85aa81d/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=OYxGlbg-CMjRJgPbhuPMYg5YfICOnm-3_NFR-POqxOA",
					"body": {
						"value": "{\"email_recepient\": \"@{pipeline().parameters.email_recepient}\",\n\"subject\": \"@{variables('email_subject')}\",\n\"body\": \"@{variables('email_body')}\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "logic_apps_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion status",
						"type": "Expression"
					}
				}
			},
			{
				"name": "logic_apps_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The table has been ingested. Please find the status below\n@{replace(string(pipeline().parameters.table_status),'\"','')}\n\npipeline run id - @{pipeline().RunId}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-07T14:01:30Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}